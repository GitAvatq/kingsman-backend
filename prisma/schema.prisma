generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Services {
  id        Int      @id @default(autoincrement())
  name      String
  price     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Master {
  id        Int      @id @default(autoincrement())
  name      String
  address   String
  status    String
  barberImg String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Rewievs {
  id        Int      @id @default(autoincrement())
  name      String
  text      String
  location  String
  image     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Blog {
  id          Int      @id @default(autoincrement())
  image       String
  name        String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Barber {
  id         Int      @id @default(autoincrement())
  image      String
  name       String
  experience Int
  status     String
  earned     Int
  rating     Int
  service    Int
  location   String
  fillialId  Int
  fillial    Fillials @relation(fields: [fillialId], references: [id])
  works      Works[]
}

model Fillials {
  id        Int      @id @default(autoincrement())
  country   String
  city      String
  address   String
  barbers   Barber[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String
}

model Works {
  id           Int    @id @default(autoincrement())
  picture_hair String
  name_hair    String
  Barber       Barber @relation(fields: [barberId], references: [id])
  barberId     Int
}
